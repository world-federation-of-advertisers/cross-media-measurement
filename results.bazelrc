# Build Results export for tracking/visualization.

build:results --bes_backend=grpcs://halo-cmm.buildbuddy.io
build:results --bes_results_url=https://halo-cmm.buildbuddy.io/invocation/
# Complete native upload retries before starting the next invocation.
# CI uses tools/bazel-with-results to preserve the build/test verdict on upload failure.
build:results --bes_upload_mode=wait_for_upload_complete
build:results --build_event_upload_max_retries=6
build:results --experimental_build_event_upload_retry_minimum_delay=5s
build:results --bes_timeout=300s
build:results --nolegacy_important_outputs
