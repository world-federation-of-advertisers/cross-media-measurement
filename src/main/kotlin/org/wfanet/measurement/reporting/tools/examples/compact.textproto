          reach: true
        }
        non_cumulative_unique {
          reach: true
        }
      }
    }
  }
  state: SUCCEEDED
  effective_impression_qualification_filters {
    impression_qualification_filter: "impressionQualificationFilters/ami"
  }
  effective_impression_qualification_filters {
    impression_qualification_filter: "impressionQualificationFilters/mrc"
  }
  effective_campaign_group: "measurementConsumers/example/reportingSets/campaign"
}
