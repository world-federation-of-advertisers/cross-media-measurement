    title: "Weekly reach"
    reporting_unit {
      components: "dataProviders/publisher-a"
      components: "dataProviders/publisher-b"
    }
    metric_frequency {
      weekly: WEDNESDAY
    }
    dimension_spec {
      filters {
        terms {
          path: "common.us_state"
          value {
            enum_value: "CALIFORNIA"
          }
        }
      }
    }
    result_group_metric_spec {
      population_size: true
      reporting_unit {
        non_cumulative {
          reach: true
        }
        cumulative {
          reach: true
        }
      }
      component {
