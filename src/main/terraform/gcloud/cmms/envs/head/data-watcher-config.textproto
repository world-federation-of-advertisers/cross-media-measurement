    queue: "event-group-sync-queue"
    serialization_key: "event-group-sync:dataProviders/Z1YwJJmvvN8"
    app_params {
      [type.googleapis.com/wfa.measurement.edpaggregator.v1alpha.EventGroupSyncParams] {
        data_provider: "dataProviders/Z1YwJJmvvN8"
      }
    }
  }
}
