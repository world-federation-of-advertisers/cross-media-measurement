# proto-file: wfa/measurement/config/edpaggregator/data_availability_sync_config.proto
# proto-message: wfa.measurement.config.edpaggregator.DataAvailabilitySyncConfigs
configs {
  data_provider: "dataProviders/T5RryPMNong"
  edp_impression_path: "edp/edp7"
  data_availability_storage {
    gcs {
      project_id: "halo-cmm-dev"
      bucket_name: "secure-computation-storage-dev-bucket"
    }
  }
  cmms_connection {
    cert_file_path: "/secrets/cert/edp7_tls.pem"
    private_key_file_path: "/secrets/key/edp7_tls.key"
    cert_collection_file_path: "/secrets/ca/kingdom_root.pem"
  }
  impression_metadata_storage_connection {
    cert_file_path: "/secrets/cert/data_availability/data_availability_tls.pem"
    private_key_file_path: "/secrets/key/data_availability/data_availability_tls.key"
    cert_collection_file_path: "/secrets/ca/metadata_storage/edp_aggregator_root.pem"
  }
  event_group_activity_publishing {
    market_time_zone { id: "UTC" }
    event_group_map_blob_uri: "gs://secure-computation-storage-dev-bucket/edp7/event-groups-map/edp7-event-group.binpb"
    event_group_map_storage {
      gcs {
        project_id: "halo-cmm-dev"
        bucket_name: "secure-computation-storage-dev-bucket"
      }
    }
  }
}
