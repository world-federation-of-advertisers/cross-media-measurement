{
  "displayName": "Meta Impression Query",
  "dashboardFilters": [],
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 6,
        "width": 48,
        "widget": {
          "title": "About",
          "text": {
            "content": "Meta impression queries by outcome, the Meta nodes that refused access, and hourly checks of whether the Meta credentials can read each expected ad account. `entity_not_found` and `permission_denied` usually mean an advertiser has not shared their ad account; Meta reports an unshared account the same way as a missing one and does not name the account behind a hidden campaign. In the account checks, `accessible` means the credentials can read the account, `permission_denied` means access was not granted, `inaccessible` means missing or unreachable, and `error` means the check itself failed. Error codes are Meta Marketing API codes.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "yPos": 6,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Impression queries per hour by outcome",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"outcome\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"workload.googleapis.com/meta.impression_query.queries\""
                  }
                }
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 6,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Unanswered impression queries per hour by entity type",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"outcome\"",
                        "metric.label.\"entity_type\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"workload.googleapis.com/meta.impression_query.queries\" metric.label.\"outcome\"!=\"success\""
                  }
                }
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 22,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Queries refused for lack of access in the last day, by Meta node",
          "timeSeriesTable": {
            "columnSettings": [],
            "dataSets": [
              {
                "minAlignmentPeriod": "86400s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "86400s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"reason\"",
                        "metric.label.\"entity_type\"",
                        "metric.label.\"node_id\"",
                        "metric.label.\"account_id\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"workload.googleapis.com/meta.impression_query.inaccessible_entities\""
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          }
        }
      },
      {
        "yPos": 38,
        "height": 20,
        "width": 48,
        "widget": {
          "title": "Last hour's result by ad account",
