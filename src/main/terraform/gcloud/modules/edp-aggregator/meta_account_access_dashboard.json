{
  "displayName": "Meta Ad Account Access",
  "dashboardFilters": [],
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 6,
        "width": 48,
        "widget": {
          "title": "About",
          "text": {
            "content": "Hourly checks of whether the Meta impression-query credentials can read each expected ad account. `enabled` means the account is onboarded; `permission_denied` means the advertiser has not granted access; `inaccessible` means the account is missing or unreachable. Error codes are Meta Marketing API codes.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "yPos": 6,
        "height": 20,
        "width": 48,
        "widget": {
          "title": "Last hour's result by ad account",
          "timeSeriesTable": {
            "columnSettings": [],
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"account_id\"",
                        "metric.label.\"result\"",
                        "metric.label.\"error_code\"",
                        "metric.label.\"error_subcode\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"workload.googleapis.com/meta.account_access_checks_total\""
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          }
        }
      },
      {
        "yPos": 26,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Checks per hour by result",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"result\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"workload.googleapis.com/meta.account_access_checks_total\""
                  }
                }
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 26,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Refusals per hour by Meta error code",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"error_code\"",
                        "metric.label.\"error_subcode\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"workload.googleapis.com/meta.account_access_checks_total\" metric.label.\"result\"!=\"enabled\""
                  }
                }
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
