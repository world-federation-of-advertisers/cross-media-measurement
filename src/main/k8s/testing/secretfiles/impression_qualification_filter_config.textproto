# proto-file: wfa/measurement/config/reporting/impression_qualification_filter_config.proto
# proto-message: ImpressionQualificationFilterConfig

# AMI
impression_qualification_filters {
  external_impression_qualification_filter_id: "ami"
  impression_qualification_filter_id: 1
  filter_specs {
    media_type: DISPLAY
  }
  filter_specs {
    media_type: VIDEO
  }
  filter_specs {
    media_type: OTHER
  }
}

# MRC
impression_qualification_filters {
  external_impression_qualification_filter_id: "mrc"
  impression_qualification_filter_id: 2
  filter_specs {
    media_type: DISPLAY
    # TODO(world-federation-of-advertisers/cross-media-measurement#4380):
    # Use `>= 0.5` once relative comparison operators are supported. The
    # disjunction covers only the declared quartiles; a value such as 0.56 is
    # dropped.
    filters: {
      terms: {
        path: "display.viewable_fraction"
        value {
          float_value: 0.5
        }
      }
      terms: {
        path: "display.viewable_fraction"
        value {
          float_value: 0.75
        }
      }
      terms: {
        path: "display.viewable_fraction"
        value {
          float_value: 1.0
        }
      }
    }
  }
}
