# proto-file: wfa/measurement/config/rate_limit_config.proto
# proto-message: RateLimitConfig

rate_limit {
  default_rate_limit {
    maximum_request_count: 20
    average_request_rate: 5
  }
  # Give ListRequisitions its own rate limiting bucket.
  per_method_rate_limit {
    key: "wfa.measurement.api.v2alpha.Requisitions/ListRequisitions"
    value {
      maximum_request_count: 20
      average_request_rate: 5
    }
  }
  # Give GetRequisition its own, more generous rate limiting bucket.
  per_method_rate_limit {
    key: "wfa.measurement.api.v2alpha.Requisitions/GetRequisition"
    value {
      maximum_request_count: 100
      average_request_rate: 100
    }
  }
  # Give VID Repository reads independent buckets so they do not compete with other clients using
  # the EDP principal's shared default bucket.
  per_method_rate_limit {
    key: "wfa.measurement.api.v2alpha.ModelLines/GetModelLine"
    value {
      maximum_request_count: 20
      average_request_rate: 5
    }
  }
  per_method_rate_limit {
    key: "wfa.measurement.api.v2alpha.ModelLines/ListModelLines"
    value {
      maximum_request_count: 20
      average_request_rate: 5
    }
  }
  per_method_rate_limit {
    key: "wfa.measurement.api.v2alpha.ModelRollouts/ListModelRollouts"
    value {
      maximum_request_count: 20
      average_request_rate: 5
    }
  }
  per_method_rate_limit {
    key: "wfa.measurement.api.v2alpha.ModelShards/ListModelShards"
    value {
      maximum_request_count: 20
      average_request_rate: 5
    }
  }
}
principal_rate_limit_override {
  key: "C2:80:7E:5D:5C:10:08:6D:C7:57:71:09:7F:73:FD:7D:41:CD:E0:23"  # Reporting server.
  value {
    default_rate_limit {
      maximum_request_count: -1  # Unlimited.
    }
  }
}

# Exempt EDPA clients only from ListRequisitions; other RPCs use the regular shared buckets.
principal_rate_limit_override {
  key: "4D:B3:F8:49:40:46:55:07:5C:34:F7:2B:3D:51:7E:70:0F:7F:DE:48"  # edp7_tls.pem
  value {
    per_method_rate_limit {
      key: "wfa.measurement.api.v2alpha.Requisitions/ListRequisitions"
      value {
        maximum_request_count: -1  # Unlimited.
      }
    }
  }
}
