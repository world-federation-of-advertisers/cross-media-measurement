package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

QA2026_SEGMENT_ENTITY_COUNTS = {
    "all4": 3,
    "e7_meta": 1,
    "e7_meta_retail": 1,
    "e7_meta_video": 1,
    "e7_retail": 1,
    "e7_video": 2,
    "e7_video_retail": 1,
    "e7only": 1,
    "meta_retail": 1,
    "meta_video": 3,
    "meta_video_retail": 1,
    "metaonly": 3,
    "noise": 1,
    "retailonly": 1,
    "video_retail": 2,
    "videoonly": 3,
}

QA2026_SPECS = [
    "qa2026_population_spec.textproto",
    "qa2026_impression_test_data_config.textproto",
] + [
    "qa2026_seg_%s.textproto" % segment
    for segment, entity_count in QA2026_SEGMENT_ENTITY_COUNTS.items()
    if entity_count == 1
] + [
    "qa2026_seg_%s_%d.textproto" % (segment, index + 1)
    for segment, entity_count in QA2026_SEGMENT_ENTITY_COUNTS.items()
    if entity_count > 1
    for index in range(entity_count)
]

genrule(
    name = "gen_qa2026_specs",
    outs = QA2026_SPECS,
    cmd = "$(execpath //src/main/kotlin/org/wfanet/measurement/loadtest/edpaggregator/tools:GenerateQa2026Specs) $(RULEDIR)",
    tools = ["//src/main/kotlin/org/wfanet/measurement/loadtest/edpaggregator/tools:GenerateQa2026Specs"],
)

filegroup(
    name = "specs",
    srcs = glob(["*.textproto"]) + [":gen_qa2026_specs"],
)
