package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

QA2026_SEGMENTS = [
    "all4",
    "e7_meta",
    "e7_meta_retail",
    "e7_meta_video",
    "e7_retail",
    "e7_video",
    "e7_video_retail",
    "e7only",
    "meta_retail",
    "meta_video",
    "meta_video_retail",
    "metaonly",
    "noise",
    "retailonly",
    "video_retail",
    "videoonly",
]

QA2026_SPECS = [
    "qa2026_population_spec.textproto",
    "qa2026_impression_test_data_config.textproto",
] + ["qa2026_seg_%s.textproto" % segment for segment in QA2026_SEGMENTS]

genrule(
    name = "gen_qa2026_specs",
    outs = QA2026_SPECS,
    cmd = "$(execpath //src/main/kotlin/org/wfanet/measurement/loadtest/edpaggregator/tools:GenerateQa2026Specs) $(RULEDIR)",
    tools = ["//src/main/kotlin/org/wfanet/measurement/loadtest/edpaggregator/tools:GenerateQa2026Specs"],
)

filegroup(
    name = "specs",
    srcs = glob(["*.textproto"]) + [":gen_qa2026_specs"],
)
