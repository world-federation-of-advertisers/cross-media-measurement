# proto-file: wfa/measurement/api/v2alpha/population_spec.proto
# proto-message: PopulationSpec

# Synthetic 360M population covering all 50 states, three age groups, both genders and both parental statuses.
# VIDs 1..10610000 cycle through 500-VID stripes over all 600 demographic cohorts.
# Remaining VIDs cover those cohorts and DC, so every state enum value has
# a positive population even when no impressions were reached in DC.

subpopulations {
  attributes {
    [type.googleapis.com/wfa.measurement.api.v2alpha.event_templates.testing.v1.Common] {
      gender: MALE
      age_group: YEARS_18_TO_34
      us_state: ALABAMA
      parental_status: NOT_PARENT
    }
  }
  vid_ranges {
    start_vid: 1
    end_vid_inclusive: 500
  }
}
