load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@wfa_rules_kotlin_jvm//kotlin:defs.bzl", "kt_jvm_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "compact_basic_report_proto",
    srcs = ["compact_basic_report.proto"],
    strip_import_prefix = "/src/main/proto",
    deps = [
        "//src/main/proto/wfa/measurement/reporting/v2alpha:basic_report_proto",
        "//src/main/proto/wfa/measurement/reporting/v2alpha:reporting_impression_qualification_filter_proto",
        "//src/main/proto/wfa/measurement/reporting/v2alpha:result_group_proto",
    ],
)

kt_jvm_proto_library(
    name = "compact_basic_report_kt_jvm_proto",
    deps = [":compact_basic_report_proto"],
)
